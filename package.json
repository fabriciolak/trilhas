{
  "name": "trilhas",
  "private": true,
  "description": "Trilhas de estudo guiadas por IA, com prática no navegador (WebContainers) e no seu computador.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @trilhas/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "validar": "pnpm --filter @trilhas/cli exec trilhas validar ../../trilhas/*.json",
    "importar-gym": "node scripts/importar-devops-gym.mjs",
    "e2e": "pnpm --filter @trilhas/web e2e"
  }
}
